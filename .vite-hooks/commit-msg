#!/bin/sh
# Conventional Commits: type(scope)!: subject. Merge, revert and autosquash messages pass through.
subject=$(sed -n '/^[^#]/{p;q;}' "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*'
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: \"$subject\" is not a Conventional Commit." >&2
  echo "Use type(scope): subject, e.g. \"fix(sdk): retry 503 on GET only\"." >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert." >&2
  exit 1
fi
