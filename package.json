{
  "name": "redmine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run --no-cache -r test && vp run -r build",
    "prepare": "vp config",
    "redmine:up": "node scripts/redmine-env.ts up",
    "redmine:down": "node scripts/redmine-env.ts down",
    "redmine:smoke": "node scripts/redmine-env.ts smoke"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
