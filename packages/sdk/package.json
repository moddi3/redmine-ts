{
  "name": "redmine-ts-sdk",
  "version": "0.0.0",
  "description": "Typed, runtime-agnostic TypeScript client for the Redmine REST API",
  "keywords": [
    "api",
    "client",
    "redmine",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "Vlad Ivanov",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "gen": "node generator/run.ts",
    "gen:check": "node generator/run.ts --check",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "test:contract": "REDMINE_CONTRACT=1 vp test --project contract"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "publint": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
