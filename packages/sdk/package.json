{
  "name": "@redmine-ts/sdk",
  "version": "0.4.0",
  "description": "Typed, runtime-agnostic TypeScript client for the Redmine REST API",
  "keywords": [
    "api",
    "client",
    "redmine",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/moddi3/redmine-ts/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/moddi3/redmine-ts/issues"
  },
  "license": "MIT",
  "author": "Vlad Ivanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moddi3/redmine-ts.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./catalog": "./dist/catalog.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "gen": "node generator/run.ts",
    "gen:check": "node generator/run.ts --check",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "test:contract": "REDMINE_CONTRACT=1 vp test --project contract"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "^26.6.5",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "publint": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
