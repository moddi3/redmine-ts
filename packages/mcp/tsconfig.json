{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2024"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@redmine-ts/sdk": ["../sdk/src/index.ts"],
      "@redmine-ts/sdk/catalog": ["../sdk/src/catalog.ts"]
    }
  },
  "include": ["src"]
}
